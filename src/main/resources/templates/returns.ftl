<#import "partials/layout.ftl" as ui>
<@ui.page title="Returns & refunds" description="Our 30-day returns policy and how to start a return.">
  <div class="page-head">
    <div>
      <span class="eyebrow">Help</span>
      <h1>Returns &amp; refunds</h1>
      <p>Changed your mind? No problem — you have 30 days.</p>
    </div>
  </div>
  <div class="panel">
    <h2 class="panel-title">30-day returns</h2>
    <p>Changed your mind? You can return any unused item in its original packaging within 30 days of delivery for a full refund.</p>

    <h2 class="panel-title panel-title-spaced">How to start a return</h2>
    <ol>
      <li>Open your <a href="/account">order history</a> and find the order.</li>
      <li>Email us the order number and the item(s) you’d like to return.</li>
      <li>We’ll send a prepaid label; refunds are issued within 5 business days of receipt.</li>
    </ol>

    <div class="actions">
      <a class="btn btn-primary" href="mailto:support@example.com?subject=Return%20request">Email a return request</a>
    </div>
  </div>
</@ui.page>
